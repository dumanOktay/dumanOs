#!/bin/bash
# ==============================================================================
# dumanOS Android & Google Play Initialization Script (ARM64 & x86_64)
# ==============================================================================

set -e

ARCH=$(uname -m)

echo "=========================================="
echo "   dumanOS Android Engine Setup ($ARCH)"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
  echo "[!] Please run with sudo: sudo dumanos-init-android"
  exit 1
fi

echo "[1/4] Configuring Waydroid repository..."
if ! command -v waydroid &> /dev/null; then
    export DISTRO="bookworm"
    curl -fsSL https://repo.waydro.id/waydroid.gpg > /usr/share/keyrings/waydroid.gpg
    echo "deb [signed-by=/usr/share/keyrings/waydroid.gpg] https://repo.waydro.id/ $DISTRO main" > /etc/apt/sources.list.d/waydroid.list
    apt-get update
    apt-get install -y waydroid
fi

echo "[2/4] Initializing Waydroid with Google Play (GAPPS) Image..."
if [ ! -d "/var/lib/waydroid/images" ] || [ ! -f "/var/lib/waydroid/images/system.img" ]; then
    waydroid init -s GAPPS -f
else
    echo "[i] Waydroid images already initialized."
fi

# Multi-window mode enabled
waydroid prop set persist.waydroid.multi_windows true

# ARM Translation only needed on x86_64 (On ARM64, APKs run natively!)
if [ "$ARCH" = "x86_64" ]; then
    echo "[3/4] x86_64 detected: Installing libndk ARM Translation..."
    TMP_DIR=$(mktemp -d)
    git clone --depth=1 https://github.com/casualsnek/waydroid_script "$TMP_DIR/waydroid_script"
    python3 -m venv "$TMP_DIR/venv"
    "$TMP_DIR/venv/bin/pip" install --upgrade pip
    "$TMP_DIR/venv/bin/pip" install -r "$TMP_DIR/waydroid_script/requirements.txt"
    "$TMP_DIR/venv/bin/python3" "$TMP_DIR/waydroid_script/main.py" install libndk
    rm -rf "$TMP_DIR"
else
    echo "[3/4] ARM64 ($ARCH) detected: Native APK execution active (No translation needed! 🚀)"
fi

echo "[4/4] Starting Waydroid Container Service..."
systemctl enable --now waydroid-container.service

echo "=========================================================="
echo " [✓] dumanOS Android Engine successfully configured!"
echo " Google Play Store and APK support is now ready."
echo " To register Google Play, run: dumanos-register-gsf"
echo "=========================================================="
